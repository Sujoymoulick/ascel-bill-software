{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ascel Bill",
  "version": "0.3.0",
  "identifier": "com.ascelstack.ascelbill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title": "Ascel Bill", "width": 1180, "height": 780, "minWidth": 780, "minHeight": 600}],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
